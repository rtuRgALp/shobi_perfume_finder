{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shobi.local/contracts/profile.v1",
  "$defs": {
    "providerAssessment": {
      "type": "object",
      "required": ["label", "scale", "votes"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "scale": { "const": "Fragella descriptive assessment" },
        "votes": { "type": "null" }
      },
      "additionalProperties": false
    }
  },
  "title": "Shobi original perfume profile v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "brand",
    "edition",
    "fragranticaId",
    "fragranticaUrl",
    "image",
    "imageEvidence",
    "gender",
    "seasons",
    "accords",
    "mainNotes",
    "pyramid",
    "description",
    "rating",
    "longevity",
    "sillage",
    "evidence",
    "validationStatus",
    "validationIssues",
    "validationChecks",
    "listings"
  ],
  "properties": {
    "nameAliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^shobi-[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": ["string", "null"]
    },
    "fragranticaId": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+$"
    },
    "fragranticaUrl": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https://"
        },
        {
          "type": "null"
        }
      ]
    },
    "image": {
      "type": ["string", "null"],
      "pattern": "^assets/[a-zA-Z0-9_./-]+$"
    },
    "imageEvidence": {
      "type": "object",
      "required": ["source", "status", "retrievedAt", "note"],
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "verified",
            "provider",
            "inherited",
            "missing",
            "conflicting"
          ]
        },
        "retrievedAt": {
          "type": ["string", "null"]
        },
        "note": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "gender": {
      "type": ["string", "null"]
    },
    "seasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mainNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "icon"],
        "properties": {
          "name": {
            "type": "string"
          },
          "icon": {
            "type": ["string", "null"],
            "pattern": "^assets/[a-zA-Z0-9_./-]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "pyramid": {
      "type": "object",
      "required": ["top", "heart", "base"],
      "properties": {
        "top": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heart": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "description": {
      "type": ["string", "null"]
    },
    "rating": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["value", "scale", "votes"],
          "properties": {
            "value": {
              "type": "number"
            },
            "scale": {
              "type": "string"
            },
            "votes": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "longevity": {
      "anyOf": [
        { "$ref": "#/$defs/providerAssessment" },
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["value", "scale", "votes"],
          "properties": {
            "value": {
              "type": "number"
            },
            "scale": {
              "type": "string"
            },
            "votes": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sillage": {
      "anyOf": [
        { "$ref": "#/$defs/providerAssessment" },
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["value", "scale", "votes"],
          "properties": {
            "value": {
              "type": "number"
            },
            "scale": {
              "type": "string"
            },
            "votes": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "identity",
        "mainNotes",
        "gender",
        "seasons",
        "accords",
        "pyramid",
        "description",
        "rating",
        "longevity",
        "sillage"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["source", "status", "retrievedAt", "note"],
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "verified",
              "provider",
              "inherited",
              "missing",
              "conflicting"
            ]
          },
          "retrievedAt": {
            "type": ["string", "null"]
          },
          "note": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "validationStatus": {
      "enum": ["green", "yellow", "red"]
    },
    "validationIssues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validationChecks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "listings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "aliases",
          "url",
          "status",
          "originalId",
          "addedDate",
          "bestSellerRank"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "pattern": "^https://leparfum\\.com\\.gr/"
          },
          "status": {
            "enum": ["active", "unavailable", "unknown"]
          },
          "originalId": {
            "type": "string"
          },
          "addedDate": {
            "type": ["string", "null"]
          },
          "bestSellerRank": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
